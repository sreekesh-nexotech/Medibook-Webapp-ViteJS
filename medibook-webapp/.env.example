# Copy to .env.local (git-ignored) and adjust. Every value here is public:
# anything prefixed VITE_ is bundled into the app — never put secrets here.

# REST API origin for a deployed build, e.g. https://api.medibook.example
# (no trailing slash, no /api/v1). Leave empty in development: requests go to
# the dev server and the proxy below forwards /api to the backend.
VITE_API_BASE_URL=

# WebSocket origin for a deployed build, e.g. wss://ws.medibook.example.
# Leave empty in development (proxied like the API).
VITE_WS_BASE_URL=

# Dev server proxy targets (read by vite.config.ts only, never bundled into
# the app code). Django serves REST on :8000 (`make run`); WebSockets need the
# ASGI server on :8001 (`make ws`) — plain runserver cannot serve /ws.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=ws://localhost:8001
